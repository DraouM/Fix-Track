{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "fixary",
  "version": "0.1.0",
  "identifier": "com.fixary.repair-management",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run dev -- --hostname 127.0.0.1 --port 3000",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Fixary",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5MTZFMEY2NjJDNDlENDMKUldSRG5jUmk5dUFXeWFVNE4rZUFVMGFzeGUvajJVc29TUDFlY3A5K0RiWE1xRVlYK1ZGZkszL0gK",
      "endpoints": [
        "https://raw.githubusercontent.com/DraouM/Fix-Track/main/latest.json"
      ]
    }
  }
}